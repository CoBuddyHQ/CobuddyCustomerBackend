# =============================================================
# CoBuddy Customer Backend — Environment Configuration Example
# Copy this file to .env and configure all variables
# =============================================================

# Server Environment
PORT=4002
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_DB=cobuddy_customer_db
POSTGRES_USER=cobuddy
POSTGRES_PASSWORD=your-secure-postgres-password
DATABASE_URL=postgresql://cobuddy:your-secure-postgres-password@localhost:5433/cobuddy_customer_db?schema=public

# Redis Cache
REDIS_URL=redis://localhost:6380

# JWT Authentication (generate 64-char random strings in production)
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# OTP Configuration
# Set OTP_DEV_BYPASS only in local development. Never define in production!
OTP_DEV_BYPASS=123456
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# CORS Whitelist (comma-separated allowed origins or * in dev)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
