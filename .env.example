# Environment
PORT=4002
NODE_ENV=development

# PostgreSQL (Use 'postgres' hostname inside Docker, 'localhost' for local node process)
POSTGRES_DB=cobuddy_customer_db
POSTGRES_USER=cobuddy
POSTGRES_PASSWORD=development-secret-password-2026
DATABASE_URL=postgresql://cobuddy:development-secret-password-2026@postgres:5432/cobuddy_customer_db?schema=public

# Redis (Use 'redis' hostname inside Docker, 'localhost' for local node process)
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET=cobuddy-customer-super-secret-jwt-key-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cobuddy-customer-super-secret-refresh-key-2026
JWT_REFRESH_EXPIRES_IN=30d

# OTP Security
OTP_DEV_BYPASS=123456
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Razorpay Integration
RAZORPAY_KEY_ID=rzp_test_TLCpKIamWxQBYy
