# =============================================================
# CoBuddy Customer Backend — Environment Configuration Example
# Copy this file to .env and configure all variables
# =============================================================

# Server Environment
PORT=4002
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_DB=cobuddy_customer_db
POSTGRES_USER=cobuddy
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis Cache
REDIS_URL=redis://localhost:6380

# JWT Authentication (generate 64-char random strings in production)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# OTP Configuration
# QA/Testing without SMS provider:
# Test code 12345465 is ONLY accepted when OTP_TEST_BYPASS_ENABLED=true AND phone is listed in OTP_TEST_ALLOWED_PHONES.
OTP_TEST_BYPASS_ENABLED=false
OTP_TEST_ALLOWED_PHONES=
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

# No SMS sender is integrated in this backend yet. Ordinary OTP requests return 503.

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS Whitelist (comma-separated allowed origins or * in dev)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Service-to-Service (S2S) Internal Communication
COMPANION_API_URL=http://localhost:4001
ADMIN_API_URL=http://localhost:4000
# Set the same random value in the customer and companion backend environments.
INTERNAL_SERVICE_SECRET=
